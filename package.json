{
  "name": "openrevu",
  "version": "2.0.0",
  "description": "OpenRevu CAD Rev 2 - Precision PDF Markup & Inspection",
  "author": "Fabio Ferreri",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "dist:light": "npm run build && powershell -ExecutionPolicy Bypass -File scripts/build-light-portable.ps1",
    "dist:rev3": "npm run build && powershell -ExecutionPolicy Bypass -File scripts/build-rev3-portable.ps1",
    "dist:portable": "npm run build && electron-builder --win portable dir",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "build": {
    "appId": "com.openrevu.cad",
    "productName": "OpenRevu",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "OpenRevu-Portable.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.16.0",
    "pako": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/node": "^22.13.9",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
